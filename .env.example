# Bank Fee Auditor - Environment Configuration
APP_NAME="Bank Fee Auditor"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# For production (PostgreSQL on Render):
# DATABASE_URL="postgresql+asyncpg://user:password@hostname:5432/bank_fee_auditor"
# For local development / quick start (SQLite support included):
DATABASE_URL="sqlite+aiosqlite:///./bank_fee_auditor.db"
# Sync URL for Alembic migrations if needed:
SYNC_DATABASE_URL="sqlite:///./bank_fee_auditor.db"

# Mock Bank Portal Settings
MOCK_BANK_API_KEY="mock-bank-live-secret-key-audit-portal"
MOCK_BANK_PORTAL_NAME="Apex National Mock Gateway"
MOCK_BANK_AUTO_ACK=true
MOCK_BANK_ACK_LATENCY_MS=150

# Security & CORS
SECRET_KEY="replace-this-with-a-secure-random-token-in-production"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000"

# Audit Engine Config
AUDIT_FLAG_SEVERITY_DEFAULT="HIGH"
MAX_DAILY_OVERDRAFT_LIMIT=3
AUDIT_TOLERANCE_CENTS=0
